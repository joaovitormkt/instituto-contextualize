{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "**/*.{html,webp,jpeg,jpg,png,svg,ico}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/artigo/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/monday-ai",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/publish-check",
      "schedule": "0 15 * * 1-5"
    }
  ]
}
